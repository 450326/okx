{
  "name": "okx-futures-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^23.4.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "install:all": "pnpm --dir backend install --ignore-scripts && pnpm --dir frontend install --ignore-scripts",
    "install:desktop": "pnpm --dir desktop install --ignore-scripts",
    "build": "pnpm --dir backend run build && pnpm --dir frontend run build",
    "dev:backend": "pnpm --dir backend run start:dev",
    "dev:frontend": "pnpm --dir frontend run dev",
    "start:backend": "pnpm --dir backend run start:prod",
    "build:desktop": "pnpm --dir desktop run dist:win"
  }
}
