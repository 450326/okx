{
  "name": "okx-futures-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:android:open": "npx cap open android",
    "cap:android:build": "npm run build && npx cap sync && npx cap build android",
    "cap:android:apk": "npm run build && npx cap sync && cd android && .\\gradlew assembleRelease",
    "cap:electron:init": "npx cap add @capacitor-community/electron",
    "cap:electron:build": "npm run build && npx cap sync && npx cap open @capacitor-community/electron"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/electron": "^2.5.0",
    "axios": "^1.8.4",
    "lightweight-charts": "^5.2.0",
    "pinia": "^2.3.1",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vue-tsc": "^2.2.8"
  }
}
