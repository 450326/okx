{
  "name": "okx-trading-desktop",
  "version": "1.0.0",
  "description": "OKX Trading Desktop Application",
  "main": "main.js",
  "author": "Kaser22",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepare-runtime": "node scripts/prepare-runtime.js",
    "pack": "node scripts/prepare-runtime.js && electron-builder --dir",
    "dist": "node scripts/prepare-runtime.js && electron-builder",
    "dist:win": "node scripts/prepare-runtime.js && electron-builder --win",
    "version:bump": "node -e \"const p=require('./package.json');const m=p.version.split('.').map(Number);m[2]++;p.version=m.join('.');require('fs').writeFileSync('./package.json',JSON.stringify(p,null,2)+'\\n');console.log('Version bumped to '+p.version);\"",
    "publish": "npm run version:bump && cd ../frontend && npm run build && cd ../backend && npm run build && cd ../desktop && node scripts/prepare-runtime.js && npx electron-builder --win --x64 -p always"
  },
  "build": {
    "appId": "com.okx.trading.desktop",
    "productName": "OKX Trading",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "update.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "node",
        "filter": ["node.exe", "node"]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "dist/**",
          "prisma/**",
          "node_modules/**",
          "package.json"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "450326",
      "repo": "okx",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OKX Trading"
    },
    "asar": false
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
