# 仅本地开发使用；.env 不会被打包进桌面安装包（desktop 构建会显式排除并在构建期检查）。
# 桌面端为每台机器生成独立密钥，保存在用户数据目录 runtime-secrets.json，并注入后端进程。
# 如果旧版本安装包曾经携带固定密钥，请视为已泄露并轮换交易所 API Key。

# 账号初始化（默认不创建任何内置账号）
# 本地演示账号：OKX_SEED_DEMO_ACCOUNTS=true，可选 OKX_DEMO_EMAIL / OKX_DEMO_PASSWORD
# 超级账号：OKX_SUPER_EMAIL / OKX_SUPER_PASSWORD（至少 12 位）
# 生产环境请设置 NODE_ENV=production，启动时会停用仍使用默认密码的旧内置账号

PORT=3000
# 下面三项不参与运行：数据库用 node:sqlite（无需 DATABASE_URL），认证用 AUTH_JWT_SECRET，
# 也没有 Redis 依赖。保留它们只是为了和设计文档里的目标架构对照。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/okx_futures?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-me"

# 预测市场（Polymarket）接口地址，一般无需修改；需要代理时可覆盖
POLYMARKET_GAMMA_API="https://gamma-api.polymarket.com"
POLYMARKET_CLOB_API="https://clob.polymarket.com"
POLYMARKET_DATA_API="https://data-api.polymarket.com"

# 交易所 API 密钥加密主密钥（生产必须；64 位 hex 或 32 字节 base64）
ACCOUNT_ENCRYPTION_KEY=
# JWT 签名密钥（生产必须）
AUTH_JWT_SECRET=
# 是否强制邮箱验证
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# 开发环境是否在注册/找回密码响应中返回 token
AUTH_EXPOSE_DEV_TOKENS=true

# 允许跨域的来源（逗号分隔）。不配置时：开发环境放行本地前端，生产环境不放行任何跨域来源。
# 桌面端由主进程传入 null（file:// 页面的 Origin），无需手工配置。
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# 监听地址；留空为 0.0.0.0，桌面端会传 127.0.0.1
# HOST=127.0.0.1
