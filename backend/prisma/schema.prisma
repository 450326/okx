generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ⚠️ 文档镜像，不是运行时依赖：后端不使用 @prisma/client，也不执行 prisma generate / db push。
// 真实表结构以 runtime 里的 SQL 为准：
//   - simulation.repository.ts / auth.store.ts / live-order.store.ts 中的 CREATE TABLE
// 本文件只作为表结构参考，与运行时保持同构，方便以后真要迁到 Prisma 时有对照。
// 金额字段在 SQLite 中使用 1e-8 最小单位的整数（BigInt），
// 运行时由 simulation.repository.ts 通过 common/money.ts 转换。

model User {
  id           String             @id
  email        String             @unique
  passwordHash String             @map("password_hash")
  nickname     String
  status       String             @default("active")
  defaultMode  String             @default("simulation") @map("default_mode")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  balances     AccountBalance[]
  positions    Position[]
  orders       Order[]
  exchangeAccounts ExchangeAccount[]

  @@map("users")
}

model AccountBalance {
  id               String   @id
  userId           String   @map("user_id")
  mode             String
  currency         String   @default("USDT")
  walletBalance    Float    @default(0) @map("wallet_balance")
  availableBalance Float    @default(0) @map("available_balance")
  positionMargin   Float    @default(0) @map("position_margin")
  orderMargin      Float    @default(0) @map("order_margin")
  unrealizedPnl    Float    @default(0) @map("unrealized_pnl")
  realizedPnl      Float    @default(0) @map("realized_pnl")
  equity           Float    @default(0)
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, mode, currency])
  @@map("account_balances")
}

model Position {
  id                String   @id
  userId            String   @map("user_id")
  mode              String
  venue             String
  symbol            String
  side              String
  marginMode        String   @default("isolated") @map("margin_mode")
  leverage          Int
  qty               Float
  entryPrice        Float    @map("entry_price")
  markPrice         Float    @default(0) @map("mark_price")
  lastPrice         Float    @default(0) @map("last_price")
  notional          Float
  initialMargin     Float    @map("initial_margin")
  maintenanceMargin Float    @map("maintenance_margin")
  liquidationPrice  Float?   @map("liquidation_price")
  isolatedMargin    Float    @map("isolated_margin")
  unrealizedPnl     Float    @default(0) @map("unrealized_pnl")
  realizedPnl       Float    @default(0) @map("realized_pnl")
  status            String   @default("open")
  openedAt          DateTime @default(now()) @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id])

  @@map("positions")
}

model Order {
  id           String    @id
  userId       String    @map("user_id")
  mode         String
  venue        String
  symbol       String
  side         String
  action       String
  orderType    String    @map("order_type")
  leverage     Int
  qty          Float
  price        Float?
  avgFillPrice Float?    @map("avg_fill_price")
  filledQty    Float     @default(0) @map("filled_qty")
  fee          Float     @default(0)
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id])

  @@map("orders")
}

model ExchangeAccount {
  id         String   @id
  userId     String   @map("user_id")
  exchange   String
  label      String
  apiKey     String   @map("api_key")
  apiSecret  String   @map("api_secret")
  passphrase String
  isTestnet  Boolean  @default(false) @map("is_testnet")
  status     String   @default("active")
  lastTestAt DateTime? @map("last_test_at")
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id])

  @@map("exchange_accounts")
}

model SimulationAccount {
  userId                   String   @id @map("user_id")
  initialCapital           BigInt   @map("initial_capital")
  walletBalance            BigInt   @map("wallet_balance")
  realizedPnl              BigInt   @map("realized_pnl")
  contractRealizedPnl      BigInt   @default(0) @map("contract_realized_pnl")
  spotRealizedPnl          BigInt   @default(0) @map("spot_realized_pnl")
  predictionRealizedPnl    BigInt   @default(0) @map("prediction_realized_pnl")
  totalFee                 BigInt   @default(0) @map("total_fee")
  nextOrderId              Int      @map("next_order_id")
  nextPositionId           Int      @map("next_position_id")
  nextSpotHoldingId        Int      @map("next_spot_holding_id")
  nextSpotOrderId          Int      @map("next_spot_order_id")
  nextPredictionOrderId    Int      @map("next_prediction_order_id")
  nextPredictionPositionId Int      @map("next_prediction_position_id")
  nextLedgerId             Int      @map("next_ledger_id")
  updatedAt                String   @map("updated_at")
  @@map("sim_accounts")
}

model SimulationPosition {
  id              String   @id
  userId          String   @map("user_id")
  symbol          String
  side            String
  leverage        Float
  marginMode      String   @default("isolated") @map("margin_mode")
  qty             Float
  entryPrice      Float    @map("entry_price")
  margin          BigInt
  realizedPnl     BigInt   @default(0) @map("realized_pnl")
  fundingFee      BigInt   @default(0) @map("funding_fee")
  lastFundingAt   String?  @map("last_funding_at")
  takeProfitPrice Float?   @map("take_profit_price")
  stopLossPrice   Float?   @map("stop_loss_price")
  status          String
  openedAt        String   @map("opened_at")
  updatedAt       String   @map("updated_at")
  closedAt        String?  @map("closed_at")
  @@index([userId])
  @@map("sim_positions")
}

model SimulationOrder {
  orderId          String   @id @map("order_id")
  userId           String   @map("user_id")
  symbol           String
  side             String
  action           String
  orderType        String   @map("order_type")
  leverage         Float
  marginMode       String   @default("isolated") @map("margin_mode")
  qty              Float
  price            Float?
  status           String
  filledQty        Float    @default(0) @map("filled_qty")
  avgFillPrice     Float?   @map("avg_fill_price")
  fee              BigInt   @default(0)
  reservedMargin   BigInt   @default(0) @map("reserved_margin")
  reduceOnly       Boolean  @default(false) @map("reduce_only")
  takeProfitPrice  Float?   @map("take_profit_price")
  stopLossPrice    Float?   @map("stop_loss_price")
  source           String
  triggerPrice     Float?   @map("trigger_price")
  marginRatioAtTrigger Float? @map("margin_ratio_at_trigger")
  positionId       String?  @map("position_id")
  rejectReason     String?  @map("reject_reason")
  createdAt        String   @map("created_at")
  updatedAt        String   @map("updated_at")
  filledAt         String?  @map("filled_at")
  @@index([userId])
  @@map("sim_orders")
}

model SimulationLedger {
  id           String  @id
  userId       String  @map("user_id")
  type         String
  amount       BigInt
  balanceAfter BigInt  @map("balance_after")
  symbol       String?
  orderId      String? @map("order_id")
  positionId   String? @map("position_id")
  remark       String?
  createdAt    String  @map("created_at")
  @@index([userId])
  @@map("sim_ledger")
}

model SimulationSpotHolding {
  id        String @id
  userId    String @map("user_id")
  symbol    String
  baseCoin  String @map("base_coin")
  qty       Float
  avgCost   Float  @map("avg_cost")
  openedAt  String @map("opened_at")
  updatedAt String @map("updated_at")
  @@index([userId])
  @@map("sim_spot_holdings")
}

model SimulationSpotOrder {
  orderId     String @id @map("order_id")
  userId      String @map("user_id")
  symbol      String
  baseCoin    String @map("base_coin")
  side        String
  qty         Float
  price       Float
  notional    BigInt
  fee         BigInt
  realizedPnl BigInt  @map("realized_pnl")
  status      String
  createdAt   String @map("created_at")
  @@index([userId])
  @@map("sim_spot_orders")
}

model SimulationPredictionPosition {
  id          String @id
  userId      String @map("user_id")
  slug        String
  marketId    String @map("market_id")
  question    String
  eventTitle  String @map("event_title")
  icon        String
  outcome     String
  outcomeName String @map("outcome_name")
  tokenId     String @map("token_id")
  qty         Float
  entryPrice  Float  @map("entry_price")
  status      String
  openedAt    String @map("opened_at")
  updatedAt   String @map("updated_at")
  @@index([userId])
  @@map("sim_prediction_positions")
}

model SimulationPredictionOrder {
  orderId     String @id @map("order_id")
  userId      String @map("user_id")
  slug        String
  marketId    String @map("market_id")
  question    String
  outcome     String
  outcomeName String @map("outcome_name")
  action      String
  qty         Float
  price       Float
  notional    BigInt
  realizedPnl BigInt  @map("realized_pnl")
  status      String
  positionId  String @map("position_id")
  createdAt   String @map("created_at")
  @@index([userId])
  @@map("sim_prediction_orders")
}

model SimulationEquityPoint {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id")
  ts     Int
  equity BigInt
  @@index([userId])
  @@map("sim_equity_history")
}

model SimulationMeta {
  key   String @id
  value String
  @@map("sim_meta")
}

model SimulationFundingRate {
  symbol          String @id
  fundingRate     Float  @map("funding_rate")
  fundingTime     Int    @map("funding_time")
  nextFundingTime Int    @map("next_funding_time")
  source          String
  fetchedAt       String @map("fetched_at")
  @@map("sim_funding_rates")
}

model SimulationFundingSettlement {
  id          Int    @id @default(autoincrement())
  userId      String @map("user_id")
  positionId  String @map("position_id")
  symbol      String
  fundingTime Int    @map("funding_time")
  fundingRate Float  @map("funding_rate")
  notional    BigInt
  amount      BigInt
  createdAt   String @map("created_at")
  @@unique([userId, positionId, fundingTime])
  @@map("sim_funding_settlements")
}

model RiskEvent {
  id              String  @id
  userId          String  @map("user_id")
  positionId      String  @map("position_id")
  orderId         String  @unique @map("order_id")
  symbol          String
  side            String
  triggerType     String  @map("trigger_type")
  triggerPrice    Float   @map("trigger_price")
  executionPrice  Float   @map("execution_price")
  marginRatio     Float   @map("margin_ratio")
  qty             Float
  realizedPnl     BigInt  @map("realized_pnl")
  ledgerId        String? @map("ledger_id")
  createdAt       String  @map("created_at")
  @@index([userId, createdAt])
  @@map("risk_events")
}
